# ---------------------------------------------------------------
# AI-medarbejdere – konfiguration
# Kopiér denne fil til .env og udfyld den udbyder du vil bruge.
# Uden nogen nogle kører appen i DEMO-tilstand (simulerede svar).
# ---------------------------------------------------------------

# Vaelg udbyder manuelt: anthropic | openai | xai | mock
# Udelades den, vaelges udbyderen automatisk ud fra hvilken nogle der findes.
# AI_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5

# --- xAI (Grok) – OpenAI-kompatibelt API ---
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4

# --- OpenAI eller andet OpenAI-kompatibelt endpoint (OpenRouter, Ollama, LM Studio ...) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1

# Overstyrer standardmodellen for alle medarbejdere der ikke har deres egen
# DEFAULT_MODEL=

# Server
PORT=4173
# HOST=127.0.0.1
